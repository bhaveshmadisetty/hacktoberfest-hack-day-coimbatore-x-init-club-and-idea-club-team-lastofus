# Copy to .env and fill in. .env is gitignored and must NEVER be committed (AGENTS.md §7).

# ---- Gemma 4 (required for reasoning) ----
# Get keys at https://aistudio.google.com/apikey
#
# Arbiter rotates across every key you provide, round robin. When one is rate
# limited (HTTP 429) or exhausts its quota, it is parked for a cooldown and the
# next key takes over, so reasoning keeps working instead of failing mid-demo.
# One key is enough to run; add more to raise the ceiling.
GEMMA_API_KEY=
GEMMA_API_KEY_2=
GEMMA_API_KEY_3=
GEMMA_API_KEY_4=
GEMMA_API_KEY_5=

# gemma-4-26b-a4b-it  (MoE, ~4B active, fast/cheap)
# gemma-4-31b-it      (dense flagship, stronger reasoning)
GEMMA_MODEL=gemma-4-26b-a4b-it

# ---- Arbiter ----
# Local telemetry + API key store
ARBITER_DB=./arbiter.db

# Salt for hashing issued API keys. CHANGE THIS in any shared deployment:
# rotating it invalidates every key already issued.
ARBITER_KEY_SALT=change-me-in-production

# Shown in the dashboard's setup snippet as DRIFTGUARD_API_URL
ARBITER_PUBLIC_URL=http://localhost:8000

# Gemma response cache, replayed when the network is unavailable
ARBITER_CACHE=./demo_cache.json

# Dashboard origins allowed to call the API
ARBITER_CORS_ORIGINS=http://localhost:3000
# Set to allow any *.vercel.app preview deployment
# ARBITER_ALLOW_VERCEL=1

# ---- Your own code (NOT read by Arbiter) ----
# Point the DriftGuard SDK at Arbiter. The key comes from the Connect tab.
# DRIFTGUARD_API_URL=http://localhost:8000
# DRIFTGUARD_API_KEY=ak_live_...
